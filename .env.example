# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for meeting-recording transcription (Whisper) and the AI chat/summary
# feature built on top of it. Generate one at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: MySQL connection string for Prisma ORM.
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://root:@localhost:3306/collabsuite"

# JWT_SECRET: Secret key for signing JWT tokens. Change in production!
JWT_SECRET="collabsuite-secret-key-change-in-production"

# ENCRYPTION_KEY: Secret key used to encrypt credentials (passwords) at rest
# in the password manager. Generate with: openssl rand -hex 32
# Change in production! Rotating it makes previously stored passwords unreadable.
ENCRYPTION_KEY="MY_ENCRYPTION_KEY"

# CORS_ORIGIN: Allowed origins for CORS. Use * for development.
CORS_ORIGIN="*"

# PORT: Server port (default 3000)
PORT=3000

# VAPID_*: Web Push keys, used to send browser/OS push notifications.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="MY_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="MY_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:you@example.com"

# SMTP_*: Optional email notifications. Leave SMTP_HOST empty to disable email sending
# (the in-app notification center and push notifications keep working either way).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Collabsuite <no-reply@collabsuite.local>"

# CHROMIUM_PATH: navegador usado para renderizar slides/HQs em PNG (no Docker já é /usr/bin/chromium).
# Vazio = Chromium do Playwright, ou Chrome/Edge instalados.
# CHROMIUM_PATH=

# ELEVENLABS_API_KEY: opcional, reserva para a narração das mini-novelas (cada usuário pode cadastrar a sua na tela Carrosséis).
# GEMINI_API_KEY (acima) também habilita o Gemini como gerador de imagens do estúdio.

# Base de conhecimento (RAG) dos agentes — Qdrant (https://qdrant.tech). Os embeddings usam a credencial OpenAI
# cadastrada em Configurações > Integrações de IA (text-embedding-3-large, 3072 dimensões).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=collabsuite_knowledge

# Instagram (publicar/agendar + automação de comentários). OPCIONAL: o app do Meta (um só para a plataforma)
# pode ser configurado na tela Instagram > Contas por um administrador; estas variáveis são só o fallback. Crie um app em developers.facebook.com
# com os produtos Facebook Login e Instagram; cadastre como URI de redirecionamento OAuth
# {APP_URL}/api/instagram/oauth/callback e como webhook (objeto Instagram, campo comments)
# {APP_URL}/api/instagram/webhook. APP_URL precisa ser público (HTTPS) — o Instagram baixa as mídias de lá.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_VERIFY_TOKEN="collabsuite_ig_verify"

# YouTube / TikTok (postagens de vídeo). Também configuráveis em Redes sociais > Contas por um administrador; aqui é só o fallback.
# Redirecionamentos: {APP_URL}/api/social/oauth/youtube/callback e {APP_URL}/api/social/oauth/tiktok/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Editor de vídeo (StudioX, pasta studiox/): app Python iniciado sob demanda pelo servidor e exposto só em /studiox (exige login).
# Requer Python 3.10+, FFmpeg e Node no PATH; dependências: python -m venv studiox/.venv && studiox/.venv/Scripts/pip install -r studiox/requirements.txt
# e, para motion graphics, (cd studiox/motion && npm ci). As chaves (ElevenLabs/Groq/OpenAI...) são salvas na tela Configurações do próprio editor.
# STUDIOX_PYTHON=
# STUDIOX_PORT=8765
# STUDIOX_STORAGE_DIR=

# GitHub (vincular repositorios aos projetos). OPCIONAL: o OAuth App (um so para a plataforma) pode ser
# configurado na aba GitHub de um projeto por um administrador; estas variaveis sao so o fallback.
# Crie em github.com > Settings > Developer settings > OAuth Apps, com callback {APP_URL}/api/github/oauth/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Apenas para GitHub Enterprise ou testes com um GitHub simulado (padroes: https://api.github.com e https://github.com)
# GITHUB_API_URL=""
# GITHUB_WEB_URL=""

# Terminal SSH por projeto (aba Terminal: so dono do projeto e admins). Tudo opcional, com padroes seguros.
# Pasta das gravacoes de sessao (conteudo sensivel, fora de /uploads e do git). Padrao: ./.ssh-recordings
# SSH_RECORDINGS_DIR=""
# Limites: sessoes simultaneas por usuario (5), inatividade em minutos (30; sem digitar E sem saida), duracao maxima em horas (8)
# SSH_MAX_SESSIONS=5
# SSH_IDLE_MINUTES=30
# SSH_MAX_HOURS=8
# Lista de hosts permitidos, separados por virgula (aceita *.dominio.com). Vazia = qualquer host exceto metadata de nuvem (169.254.x.x)
# SSH_ALLOWED_HOSTS=""
