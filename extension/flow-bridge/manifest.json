{
  "manifest_version": 3,
  "name": "CollabSuite · Google Flow",
  "version": "1.0.0",
  "description": "Gera as imagens das mini-novelas da CollabSuite no Google Flow, usando a sua conta logada.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://flow.google.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "CollabSuite · Google Flow" },
  "content_scripts": [
    { "matches": ["https://flow.google.com/*"], "js": ["inject.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://flow.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
